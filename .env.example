# Emby REST API connection
EMBY_HOST=emby
EMBY_PORT=8096
EMBY_API_KEY=your-api-key-here

# Path to Emby programdata inside the container (mapped via volume)
EMBY_CONFIG_PATH=/emby-config

# Path to Emby programdata on the host (used by docker-compose volume mount)
EMBY_CONFIG_HOST_PATH=/path/to/emby/programdata

# Comma-separated list of media library mount paths (inside the container).
# Used by storage_report, audit_paths, and connectivity_check tools.
# Example: /mnt/movies,/mnt/tv,/mnt/music
EMBY_MEDIA_PATHS=

# MCP server port
MCP_PORT=8486
